diff --git a/docker/pip-constraints.txt b/docker/pip-constraints.txt
new file mode 100644
index 0000000..fe7a3ac
--- /dev/null
+++ b/docker/pip-constraints.txt
@@ -0,0 +1,6 @@
+# Pin versions that drifted since the v2.1.1 release (see build failure 2026-10-02):
+# torch 2.14 (cu130) needs driver >= 580; we are on 550.
+torch==2.7.0
+torchvision==0.22.0
+# setuptools >= 81 removed pkg_resources, which flatdict==4.0.1's setup.py imports (applies to isolated build envs too)
+setuptools<81
