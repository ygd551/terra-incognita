diff --git a/docker/Dockerfile.base b/docker/Dockerfile.base
index 2c9b953..53480e1 100644
--- a/docker/Dockerfile.base
+++ b/docker/Dockerfile.base
@@ -84,6 +84,12 @@ RUN touch /bin/nvidia-smi && \
     touch /var/run/nvidia-persistenced/socket
 
 # installing Isaac Lab dependencies
+# pin drifted deps (torch/setuptools); PIP_CONSTRAINT also reaches pip's isolated build envs
+ENV PIP_CONSTRAINT=${ISAACLAB_PATH}/docker/pip-constraints.txt
+# slow/flaky link: pip>=25.1 can resume interrupted downloads instead of failing the whole build
+ENV PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10 PIP_RESUME_RETRIES=50
+RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/pip \
+    ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install "pip>=25.1,<26"
 # use pip caching to avoid reinstalling large packages
 RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/pip \
     ${ISAACLAB_PATH}/isaaclab.sh --install
