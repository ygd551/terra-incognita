<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS profile of every ROS 2 process in isaac_explore (FASTRTPS_DEFAULT_PROFILES_FILE: the isaac_explore
     container, the ros1_bridge containers of ros1_ws/). Written from the Fast DDS documentation (XML profiles):
     - UDP only: the containers share the host network but not /dev/shm, so shared-memory transport cannot work
       between them (discovery would succeed and data never arrive).
     - Large socket buffers: point clouds (~0.5 MB) and camera images (~1.2 MB) are sent as bursts of 64 KB UDP
       fragments; with the kernel default (208 KB) the receiving socket overflowed (RcvbufErrors in /proc/net/snmp)
       and the reliable protocol repaired the loss only at the next heartbeat (3 s by default): the scans reached
       FAST-LIVO2 up to 3 s late and it lost track. The kernel caps these sizes at net.core.rmem_max /
       wmem_max: raise those too (README, Troubleshooting).
     - Heartbeat every 50 ms instead of 3 s: what is still lost is resent within ~0.1 s. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_large_buffers</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>8388608</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="isaac_explore_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_large_buffers</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <data_writer profile_name="isaac_explore_writer" is_default_profile="true">
    <times>
      <heartbeatPeriod>
        <sec>0</sec>
        <nanosec>50000000</nanosec>
      </heartbeatPeriod>
    </times>
  </data_writer>
</profiles>
