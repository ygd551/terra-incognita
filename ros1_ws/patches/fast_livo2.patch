 // Provide output format for LiDAR-visual BA
+// isaac_explore: the map to save (pcd_save) collects every frame's points until the node stops: ~1 GB per few minutes
+// and memory to match (the container is capped). Above this many points it is thinned in place to one point per
+// pcd_save/filter_size_pcd voxel, the latest one seen (its colour is the latest view). Plain hashing with 64-bit voxel
+// keys (21 bits per axis: +-100 km at 0.1 m), not pcl::VoxelGrid: that one, instantiated here under -march=native,
+// crashed the node (SIGSEGV right when the map first reached this size), and overflows 32-bit indices past ~250 m.
+template <typename CloudPtr> static void compactMap(CloudPtr &cloud, double leaf)
+{
+  if (cloud->size() < 3000000) return;
+  std::unordered_map<uint64_t, size_t> last;   // voxel -> index of the latest point in it
+  last.reserve(cloud->size());
+  const auto key = [leaf](double v) { return static_cast<uint64_t>(static_cast<int64_t>(std::floor(v / leaf)) & 0x1FFFFF); };
+  for (size_t i = 0; i < cloud->size(); ++i)
+  {
+    const auto &p = cloud->points[i];
+    last[(key(p.x) << 42) | (key(p.y) << 21) | key(p.z)] = i;
+  }
+  CloudPtr out(new typename CloudPtr::element_type());
+  out->reserve(last.size());
+  for (const auto &kv : last) out->push_back(cloud->points[kv.second]);
+  cloud = out;
+}
